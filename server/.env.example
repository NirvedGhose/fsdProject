MONGO_URI=mongodb://127.0.0.1:27017/veritas
JWT_SECRET=change-me-to-a-long-random-string
PORT=5000
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Website address(es) allowed to call this API, comma-separated. Needed when the client is on a different domain (e.g. Vercel).
CLIENT_ORIGIN=
# Max size of one uploaded file in MB (use 4 on Vercel, which rejects request bodies over 4.5 MB)
MAX_UPLOAD_MB=10
